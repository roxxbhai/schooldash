{
  "name": "schooldash-1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "bootstrap:admin": "tsx --conditions=react-server --env-file=.env.local scripts/bootstrap-admin.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:push": "sh -c 'set -a && . ./.env.local && set +a && supabase db push --db-url \"$SUPABASE_DB_URL\" \"$@\"' --",
    "db:types": "sh -c 'set -a && . ./.env.local && set +a && supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public > src/types/database/index.ts'",
    "db:migrations": "sh -c 'set -a && . ./.env.local && set +a && supabase migration list --db-url \"$SUPABASE_DB_URL\" \"$@\"' --",
    "db:advisors": "sh -c 'set -a && . ./.env.local && set +a && supabase db advisors --db-url \"$SUPABASE_DB_URL\" --type all \"$@\"' --"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pg": "8.23.1",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
